{
  "name": "hapa-admin",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "hapa-data", "database_id": "c4240550-8ec9-4331-9d53-a412b583f102" }]
  // Set in the Cloudflare dashboard (Settings > Variables): ACCESS_TEAM (your Zero Trust team name) and ACCESS_AUD (the Access application's AUD tag).
  // Optional: SUPER_ADMINS (comma-separated emails; default masaikta@gmail.com).
}
